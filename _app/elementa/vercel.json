{
    "buildCommand": "pnpm turbo run build --filter=@elllphnt/elementa",
    "outputDirectory": "dist",
    "rewrites": [
        {
            "source": "/editor",
            "destination": "/editor.html"
        },
        {
            "source": "/viewer",
            "destination": "/viewer.html"
        }
    ],
    "cleanUrls": true,
    "trailingSlash": false
}