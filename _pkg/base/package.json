{
  "name": "@elllphnt/elementa-base",
  "type": "module",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf build && rm -rf dist",
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -w -p tsconfig.build.json",
    "packup": "tsx scripts/packup.ts",
    "pub": "npm run clean && npm run build && npm run packup && cd dist && npm publish"
  },
  "dependencies": {
    "yup": "^1.4.0",
    "zod": "^3.24.4"
  }
}