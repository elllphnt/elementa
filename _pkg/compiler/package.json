    "fast-xml-parser": "^4.3.6",
    "jsep": "^1.3.8",
    "json-refs": "^3.0.15",
    "lodash": "^4.17.21",
    "lodash.camelcase": "^4.3.0",
    "rxjs": "^7.8.1",
