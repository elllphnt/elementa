{
    "name": "ComponentData",
    "strict": true,
    "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
            "name": {
                "type": "string",
                "description": "The name of the component."
            },
            "template": {
                "$ref": "#/definitions/FragmentData"
            }
        },
        "definitions": {
            "LengthData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "value": {
                        "type": "number"
                    },
                    "unit": {
                        "type": "string",
                        "enum": [
                            "px",
                            "em",
                            "rem",
                            "vh",
                            "vw"
                        ]
                    }
                }
            },
            "FractionData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "value": {
                        "type": "number"
                    },
                    "unit": {
                        "type": "string",
                        "enum": [
                            "fr"
                        ]
                    }
                }
            },
            "ColorData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "r": {
                        "type": "number"
                    },
                    "g": {
                        "type": "number"
                    },
                    "b": {
                        "type": "number"
                    },
                    "a": {
                        "type": "number"
                    }
                }
            },
            "FillData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "image",
                            "gradient",
                            "color"
                        ]
                    },
                    "color": {
                        "$ref": "#/definitions/ColorData"
                    },
                    "gradient": {
                        "$ref": "#/definitions/GradientData"
                    },
                    "image": {
                        "type": "string"
                    }
                }
            },
            "GradientData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "variant": {
                        "type": "string",
                        "enum": [
                            "linear",
                            "radial",
                            "conic"
                        ]
                    },
                    "angle": {
                        "type": "number"
                    },
                    "stops": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                                "position": {
                                    "type": "number"
                                },
                                "color": {
                                    "$ref": "#/definitions/ColorData"
                                }
                            }
                        }
                    },
                    "position": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            }
                        }
                    }
                }
            },
            "LinkData": {
                "type": "object",
                "additionalProperties": false,
                "description": "The link data associated with the element.",
                "properties": {
                    "href": {
                        "type": "string"
                    },
                    "hreflang": {
                        "type": "string"
                    },
                    "ping": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "referrerPolicy": {
                        "type": "string"
                    },
                    "rel": {
                        "type": "string"
                    },
                    "target": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string"
                    }
                }
            },
            "StyleData": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "title": "StyleData",
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "position": {
                        "type": "string",
                        "enum": [
                            "static",
                            "absolute",
                            "relative",
                            "fixed",
                            "sticky"
                        ],
                        "description": "The position property of the element."
                    },
                    "top": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The top position of the element."
                    },
                    "left": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The left position of the element."
                    },
                    "right": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The right position of the element."
                    },
                    "bottom": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The bottom position of the element."
                    },
                    "width": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            },
                            {
                                "$ref": "#/definitions/FractionData"
                            },
                            {
                                "type": "string",
                                "enum": [
                                    "fit"
                                ]
                            }
                        ],
                        "description": "The width of the element."
                    },
                    "height": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            },
                            {
                                "$ref": "#/definitions/FractionData"
                            },
                            {
                                "type": "string",
                                "enum": [
                                    "fit"
                                ]
                            }
                        ],
                        "description": "The height of the element."
                    },
                    "min-width": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The minimum width of the element."
                    },
                    "min-height": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The minimum height of the element."
                    },
                    "max-width": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The maximum width of the element."
                    },
                    "max-height": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The maximum height of the element."
                    },
                    "aspect-ratio": {
                        "type": "number",
                        "description": "The aspect ratio of the element."
                    },
                    "layout": {
                        "type": "string",
                        "enum": [
                            "flex",
                            "grid"
                        ],
                        "description": "The layout type for the element."
                    },
                    "align-items": {
                        "type": "string",
                        "enum": [
                            "start",
                            "center",
                            "end",
                            "stretch"
                        ],
                        "description": "The align-items property for flexbox or grid layout."
                    },
                    "justify-items": {
                        "type": "string",
                        "enum": [
                            "start",
                            "center",
                            "end",
                            "space-between",
                            "space-around",
                            "space-evenly"
                        ],
                        "description": "The justify-items property for grid layout."
                    },
                    "align-content": {
                        "type": "string",
                        "enum": [
                            "start",
                            "center",
                            "end",
                            "space-between",
                            "space-around",
                            "space-evenly"
                        ],
                        "description": "The align-content property for grid or flexbox layout."
                    },
                    "justify-content": {
                        "type": "string",
                        "enum": [
                            "start",
                            "center",
                            "end",
                            "stretch"
                        ],
                        "description": "The justify-content property for flexbox or grid layout."
                    },
                    "overflow": {
                        "type": "string",
                        "enum": [
                            "visible",
                            "hidden",
                            "scroll-x",
                            "scroll-y",
                            "scroll-area"
                        ],
                        "description": "The overflow property of the element."
                    },
                    "z-index": {
                        "type": "number",
                        "description": "The z-index property of the element."
                    },
                    "flex-direction": {
                        "type": "string",
                        "enum": [
                            "row",
                            "column"
                        ],
                        "description": "The flex-direction property for flexbox layout."
                    },
                    "flex-wrap": {
                        "type": "string",
                        "enum": [
                            "wrap",
                            "nowrap"
                        ],
                        "description": "The flex-wrap property for flexbox layout."
                    },
                    "grid-template-columns": {
                        "type": "number",
                        "description": "The number of columns in the grid layout."
                    },
                    "grid-template-rows": {
                        "type": "number",
                        "description": "The number of rows in the grid layout."
                    },
                    "grid-column": {
                        "type": "number",
                        "description": "The grid-column property to define an element's column position."
                    },
                    "grid-row": {
                        "type": "number",
                        "description": "The grid-row property to define an element's row position."
                    },
                    "gap-x": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The horizontal gap between grid or flexbox items."
                    },
                    "gap-y": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The vertical gap between grid or flexbox items."
                    },
                    "background": {
                        "anyOf": [
                            {
                                "$ref": "#/definitions/FillData"
                            },
                            {
                                "$ref": "#/definitions/ColorData"
                            }
                        ],
                        "description": "The background property of the element."
                    },
                    "background-size": {
                        "type": "string",
                        "enum": [
                            "cover",
                            "contain",
                            "auto"
                        ],
                        "description": "The background-size property."
                    },
                    "background-position-x": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            },
                            {
                                "$ref": "#/definitions/PercentData"
                            }
                        ],
                        "description": "The horizontal position of the background image."
                    },
                    "background-position-y": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            },
                            {
                                "$ref": "#/definitions/PercentData"
                            }
                        ],
                        "description": "The vertical position of the background image."
                    },
                    "background-repeat": {
                        "type": "string",
                        "description": "The background-repeat property."
                    },
                    "border-top-style": {
                        "type": "string",
                        "description": "The style of the top border."
                    },
                    "border-top-width": {
                        "type": "number",
                        "description": "The width of the top border."
                    },
                    "border-top-color": {
                        "$ref": "#/definitions/ColorData",
                        "description": "The color of the top border."
                    },
                    "border-right-style": {
                        "type": "string",
                        "description": "The style of the right border."
                    },
                    "border-right-width": {
                        "type": "number",
                        "description": "The width of the right border."
                    },
                    "border-right-color": {
                        "$ref": "#/definitions/ColorData",
                        "description": "The color of the right border."
                    },
                    "border-bottom-style": {
                        "type": "string",
                        "description": "The style of the bottom border."
                    },
                    "border-bottom-width": {
                        "type": "number",
                        "description": "The width of the bottom border."
                    },
                    "border-bottom-color": {
                        "$ref": "#/definitions/ColorData",
                        "description": "The color of the bottom border."
                    },
                    "border-left-style": {
                        "type": "string",
                        "description": "The style of the left border."
                    },
                    "border-left-width": {
                        "type": "number",
                        "description": "The width of the left border."
                    },
                    "border-left-color": {
                        "$ref": "#/definitions/ColorData",
                        "description": "The color of the left border."
                    },
                    "outline-style": {
                        "type": "string",
                        "description": "The outline style."
                    },
                    "outline-width": {
                        "type": "number",
                        "description": "The outline width."
                    },
                    "outline-color": {
                        "$ref": "#/definitions/ColorData",
                        "description": "The outline color."
                    },
                    "corner-top-left": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The radius of the top-left corner."
                    },
                    "corner-top-right": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The radius of the top-right corner."
                    },
                    "corner-bottom-right": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The radius of the bottom-right corner."
                    },
                    "corner-bottom-left": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The radius of the bottom-left corner."
                    },
                    "color": {
                        "$ref": "#/definitions/ColorData",
                        "description": "The text color of the element."
                    },
                    "opacity": {
                        "type": "number",
                        "description": "The opacity of the element."
                    },
                    "visibility": {
                        "type": "string",
                        "description": "The visibility of the element."
                    },
                    "cursor": {
                        "type": "string",
                        "description": "The cursor style when hovering over the element."
                    },
                    "font-family": {
                        "type": "string",
                        "description": "The font family for text within the element."
                    },
                    "font-weight-style": {
                        "type": "string",
                        "description": "The weight and style of the font."
                    },
                    "font-size": {
                        "anyOf": [
                            {
                                "type": "number"
                            },
                            {
                                "$ref": "#/definitions/LengthData"
                            }
                        ],
                        "description": "The font size for text within the element."
                    },
                    "text-transform": {
                        "type": "string",
                        "description": "The text transformation applied to the content."
                    },
                    "text-decoration": {
                        "type": "string",
                        "description": "The text decoration applied to the content."
                    },
                    "letter-spacing": {
                        "type": "number",
                        "description": "The space between letters in the text."
                    },
                    "text-overflow": {
                        "type": "string",
                        "description": "The behavior of text overflow."
                    },
                    "white-space": {
                        "type": "string",
                        "description": "The white-space handling for text content."
                    },
                    "word-break": {
                        "type": "string",
                        "description": "How words should break within the element."
                    },
                    "text-align": {
                        "type": "string",
                        "description": "The horizontal alignment of text."
                    },
                    "line-height": {
                        "type": "number",
                        "description": "The line height for text."
                    }
                }
            },
            "PercentData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "value": {
                        "type": "number"
                    },
                    "unit": {
                        "type": "string",
                        "enum": [
                            "%"
                        ]
                    }
                }
            },
            "AnimationData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "keyframe": {
                        "type": "string"
                    },
                    "duration": {
                        "type": "number"
                    },
                    "timingFunction": {
                        "type": "string"
                    },
                    "delay": {
                        "type": "number"
                    },
                    "iterations": {
                        "type": "number"
                    },
                    "iterationCount": {
                        "type": "number"
                    },
                    "direction": {
                        "type": "string"
                    },
                    "fillMode": {
                        "type": "string"
                    },
                    "playState": {
                        "type": "string"
                    }
                }
            },
            "FilterData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "key": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "blur",
                            "brightness",
                            "contrast",
                            "dropShadow",
                            "boxShadow",
                            "grayscale",
                            "hueRotate",
                            "invert",
                            "opacity",
                            "saturate",
                            "sepia",
                            "hidden"
                        ]
                    },
                    "target": {
                        "type": "string",
                        "enum": [
                            "element",
                            "backdrop"
                        ]
                    },
                    "data": {
                        "anyOf": [
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "radius": {
                                        "type": "number"
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "value": {
                                        "type": "number"
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "angle": {
                                        "type": "number"
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "offsetX": {
                                        "type": "number"
                                    },
                                    "offsetY": {
                                        "type": "number"
                                    },
                                    "blurRadius": {
                                        "type": "number"
                                    },
                                    "color": {
                                        "$ref": "#/definitions/ColorData"
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                    "inset": {
                                        "type": "boolean"
                                    },
                                    "offsetX": {
                                        "type": "number"
                                    },
                                    "offsetY": {
                                        "type": "number"
                                    },
                                    "blurRadius": {
                                        "type": "number"
                                    },
                                    "spreadRadius": {
                                        "type": "number"
                                    },
                                    "color": {
                                        "$ref": "#/definitions/ColorData"
                                    }
                                }
                            }
                        ]
                    },
                    "hidden": {
                        "type": "boolean"
                    }
                }
            },
            "ContainerElementData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "The type of the entity.",
                        "enum": [
                            "element:container"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the entity."
                    },
                    "link": {
                        "$ref": "#/definitions/LinkData"
                    },
                    "style": {
                        "$ref": "#/definitions/StyleData"
                    },
                    "children": {
                        "type": "array",
                        "description": "The children elements inside the container.",
                        "items": {
                            "$ref": "#/definitions/ElementData"
                        }
                    }
                }
            },
            "TextElementData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "The type of the entity.",
                        "enum": [
                            "element:container"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the entity."
                    },
                    "link": {
                        "$ref": "#/definitions/LinkData"
                    },
                    "style": {
                        "$ref": "#/definitions/StyleData"
                    },
                    "text": {
                        "type": "string",
                        "description": "The text content of the element."
                    }
                }
            },
            "MediaElementData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "The type of the entity.",
                        "enum": [
                            "element:container"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the entity."
                    },
                    "link": {
                        "$ref": "#/definitions/LinkData"
                    },
                    "style": {
                        "$ref": "#/definitions/StyleData"
                    },
                    "media": {
                        "type": "string",
                        "description": "The media content of the element."
                    }
                }
            },
            "VectorElementData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "type": {
                        "type": "string",
                        "description": "The type of the entity.",
                        "enum": [
                            "element:container"
                        ]
                    },
                    "name": {
                        "type": "string",
                        "description": "The name of the entity."
                    },
                    "link": {
                        "$ref": "#/definitions/LinkData"
                    },
                    "style": {
                        "$ref": "#/definitions/StyleData"
                    },
                    "vector": {
                        "type": "string",
                        "description": "The vector content of the element."
                    }
                }
            },
            "ElementData": {
                "anyOf": [
                    {
                        "$ref": "#/definitions/ContainerElementData"
                    },
                    {
                        "$ref": "#/definitions/TextElementData"
                    },
                    {
                        "$ref": "#/definitions/MediaElementData"
                    },
                    {
                        "$ref": "#/definitions/VectorElementData"
                    }
                ]
            },
            "FragmentData": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/definitions/ElementData"
                        }
                    }
                }
            }
        }
    }
}