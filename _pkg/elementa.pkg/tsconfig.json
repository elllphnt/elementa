{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "src/renderer/components/widgets/controllers/.tsx",
    "../elementa-models.pkg/src/css",
    "../elementa-models.pkg/src/project/package_manager.ts"
  ],
  "exclude": ["node_modules", "dist", "parcel/dist"]
}
