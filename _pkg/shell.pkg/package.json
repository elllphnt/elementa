{
    "name": "@repo/shell",
    "private": true,
    "version": "0.0.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "babel:build": "babel src -d dist -x .ts,.tsx",
        "tsc:build": "tsc --project tsconfig.build.json",
        "dev": "parcel dev/src/index.html --dist-dir dev/dist --no-cache",
        "build": "yarn babel:build && yarn tsc:build",
        "watch:tsc": "tsc --project tsconfig.build.json --watch",
        "watch:babel": "babel src -d dist -x .ts,.tsx --watch",
        "watch": "yarn watch:tsc & yarn watch:babel"
    },
    "devDependencies": {
        "@repo/components": "*",
        "@repo/backend": "*",
        "@repo/styles": "*",
        "@repo/utils": "*",
        "@types/react": "^18.2.32",
        "@types/react-dom": "^18.2.14",
        "parcel": "^2.11.0",
        "process": "^0.11.10",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "typescript": "5.2.2"
    },
    "peerDependencies": {},
    "dependencies": {
        "classnames": "^2.5.1",
        "deep-object-diff": "^1.1.9",
        "lodash": "^4.17.21",
        "react-dnd": "^16.0.1",
        "react-dnd-html5-backend": "^16.0.1",
        "react-error-boundary": "^4.0.12",
        "rxjs": "^7.8.1"
    }
}