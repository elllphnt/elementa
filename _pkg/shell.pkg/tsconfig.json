{
  "compilerOptions": {
    "target": "ES2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": [
    "src/**/*",
    "../components/src/action/_model.ts",
    "../components/src/icon",
    "../components/src/placeholder",
    "../components/src/context_menu/_context_menu_manager.ts",
    "../components/src/anchor/hook.ts"
  ],
  "exclude": ["node_modules", "dist", "parcel/dist"]
}
