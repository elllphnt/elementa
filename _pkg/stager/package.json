{
    "name": "@repo/elementa-stager",
    "private": true,
    "version": "0.1.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "watch:tsc": "tsc-watch --project tsconfig.build.json --onSuccess \"tscpaths -p tsconfig.build.json -s ./src -o ./dist\" --onFailure \"tscpaths -p tsconfig.build.json -s ./src -o ./dist\"",
        "watch:babel": "babel src -d dist -x .ts,.tsx --watch",
        "watch": "yarn watch:tsc & yarn watch:babel",
        "build": "tsx scripts/build.ts",
        "pub": "tsx scripts/publish.ts"
    },
    "devDependencies": {
        "@babel/core": "^7.12.0",
        "@babel/plugin-transform-react-jsx": "^7.23.4",
        "@babel/plugin-transform-typescript": "^7.23.6",
        "@repo/elementa-renderer": "workspace:*",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "babel-plugin-module-resolver": "^5.0.0",
        "eslint-plugin-import": "^2.29.1",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "typescript": "5.2.2"
    },
    "peerDependencies": {},
    "dependencies": {
        "@elllphnt/elementa-base": "workspace:*",
        "@elllphnt/elementa-utils": "workspace:*",
        "rxjs": "^7.8.1",
        "tsc-watch": "^6.2.0",
        "yarn": "^1.22.22"
    }
}