{
    "name": "@repo/styles",
    "version": "0.1.0",
    "description": "CSS styles for Elllephant",
    "scripts": {
        "build:editor": "tailwindcss build -c tailwind.config.editor.js -i src/main.css -o dist/elll.css --minify",
        "watch:editor": "tailwindcss build -c tailwind.config.editor.js -i src/main.css -o dist/elll.css --watch"
    },
    "devDependencies": {
        "tailwindcss": "^3.4.1"
    }
}