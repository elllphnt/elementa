{
    "name": "elementa",
    "private": true,
    "scripts": {
        "clean": "find . -type d \\( -name node_modules -o -name .turbo -o -name dist -o -name build \\) -prune -exec rm -rf '{}' +",
        "build": "turbo run build --filter=@elllphnt/elementa",
        "studio": "turbo run dev --filter=@elllphnt/elementa-studio-server --filter=@elllphnt/elementa-studio-client --filter=@elllphnt/elementa",
        "publish-all": "tsx scripts/publish.ts"
    },
    "workspaces": [
        "apps/*",
        "packages/engine/*",
        "packages/engine/backends/*",
        "packages/schema/*",
        "packages/tools/*",
        "packages/utils/*",
        "workflows/*",
        "playground"
    ],
    "devDependencies": {
        "@changesets/cli": "^2.29.5",
        "@eslint/js": "^9.26.0",
        "@manypkg/get-packages": "^3.0.0",
        "@playwright/experimental-ct-react": "^1.53.2",
        "@playwright/test": "^1.53.2",
        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.15.30",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@typescript-eslint/eslint-plugin": "^8.35.1",
        "@typescript-eslint/parser": "^8.35.1",
        "concurrently": "^9.1.2",
        "esbuild": "^0.20.2",
        "eslint": "^9.26.0",
        "eslint-plugin-import": "^2.29.1",
        "jsdom": "^26.1.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "rxjs": "^7.8.2",
        "tsc-alias": "^1.8.16",
        "tsc-watch": "^6.3.1",
        "tscpaths": "^0.0.9",
        "tsx": "^4.19.4",
        "turbo": "^2.5.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.35.1",
        "uvu": "^0.5.6",
        "vite": "^6.3.5",
        "vite-tsconfig-paths": "^5.1.4",
        "vitest": "^3.2.2"
    },
    "packageManager": "pnpm@10.10.0"
}
