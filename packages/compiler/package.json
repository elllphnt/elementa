{
  "name": "@elllphnt/elll-compiler",
  "type": "module",
  "version": "0.20.4",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "packup": "node ./scripts/packup.js",
    "pub": "npm run build && npm run packup && cd dist && npm publish",
    "build:esbuild": "esbuild src/elll.ts --bundle --format=esm --outfile=es_dist/index.js --minify --analyze"
  },
  "dependencies": {
    "@elllphnt/elementa-base": "workspace:*"
  }
}