{
  "name": "@elllphnt/elementa-transformer-primitives",
  "type": "module",
  "version": "0.1.11",
  "private": true,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "clean": "rm -rf build && rm -rf dist",
    "build": "npm run lint && tsc -p tsconfig.build.json",
    "watch": "tsc -w -p tsconfig.build.json",
    "packup": "packup",
    "pub": "npm run clean && npm run build && npm run packup && cd dist && npm publish",
    "lint": "eslint src"
  },
  "dependencies": {
    "@elllphnt/elementa-base": "workspace:*"
  },
  "devDependencies": {
    "@repo/packup": "workspace:*"
  }
}