{
  "name": "@elllphnt/elementa-css",
  "type": "module",
  "version": "0.28.4",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run lint && tsc -p tsconfig.build.json",
    "build:dist": "npm run lint && tsc -p tsconfig.build.json --sourceMap false --declarationMap false",
    "watch": "tsc --watch",
    "packup": "tsx scripts/packup.ts",
    "pub": "npm run test:run && npm run clean && npm run build:dist && npm run packup && cd dist && npm publish",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest --run"
  },
  "dependencies": {
    "csstype": "^3.1.3"
  },
  "peerDependencies": {
    "@elllphnt/elementa-base": "workspace:*"
  }
}