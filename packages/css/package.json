{
  "name": "@elllphnt/elementa-css",
  "type": "module",
  "version": "0.28.7",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "clean": "rm -rf build && rm -rf dist",
    "build": "npm run lint && tsc -p tsconfig.build.json",
    "watch": "tsc -w -p tsconfig.build.json",
    "packup": "tsx scripts/packup.ts",
    "pub": "npm run test:run && npm run clean && npm run build && npm run packup && cd dist && npm publish",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest --run",
    "types": "tsc src/index.ts --declaration --emitDeclarationOnly --outFile schema/index.d.ts"
  },
  "dependencies": {
    "csstype": "^3.1.3"
  },
  "peerDependencies": {
    "@elllphnt/elementa-base": "workspace:*"
  }
}