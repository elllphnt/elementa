{
    "name": "@elllphnt/elementa-interactor",
    "version": "0.1.1",
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "type": "module",
    "scripts": {
        "clean": "rm -rf dist build",
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --verbose",
        "build:dist": "tsc -p tsconfig.build.json --sourceMap false --declarationMap false && tsc-alias -p tsconfig.build.json --verbose",
        "build:watch": "tsc -p tsconfig.build.json --watch",
        "alias:watch": "tsc-alias -p tsconfig.build.json --watch",
        "watch": "concurrently \"npm run build:watch\" \"npm run alias:watch\"",
        "packup": "tsx scripts/packup.ts",
        "pub": "npm run clean && npm run build:dist && npm run packup && cd dist && npm publish",
        "test": "vitest"
    },
    "dependencies": {
        "@elllphnt/elementa-base": "workspace:*",
        "@elllphnt/elementa-kernel": "workspace:*",
        "@elllphnt/elementa-lang-utils": "workspace:*",
        "@elllphnt/elementa-math-utils": "workspace:*",
        "@elllphnt/elementa-models": "workspace:*",
        "@elllphnt/elementa-react-utils": "workspace:*",
        "@elllphnt/elementa-runtime": "workspace:*",
        "@elllphnt/elementa-scene": "workspace:*",
        "classnames": "^2.5.1",
        "lodash": "^4.17.21",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-history": "^1.4.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.1",
        "prosemirror-state": "^1.4.3",
        "prosemirror-view": "^1.40.0",
        "rxjs": "^7.8.2",
        "tinycolor2": "^1.6.0",
        "tsc-watch": "^6.3.1"
    },
    "devDependencies": {
        "@types/tinycolor2": "^1.4.6"
    }
}
