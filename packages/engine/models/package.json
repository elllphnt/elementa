{
    "name": "@elllphnt/elementa-models",
    "version": "0.3.4",
    "type": "module",
    "scripts": {
        "clean": "rm -rf dist build",
        "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --verbose",
        "build:dist": "tsc -p tsconfig.build.json --sourceMap false --declarationMap false && tsc-alias -p tsconfig.build.json --verbose",
        "build:watch": "tsc -p tsconfig.build.json --watch",
        "alias:watch": "tsc-alias -p tsconfig.build.json --watch",
        "watch": "concurrently \"npm run build:watch\" \"npm run alias:watch\"",
        "packup": "tsx scripts/packup.ts",
        "pub": "npm run clean && npm run build:dist && npm run packup && cd dist && npm publish",
        "test": "vitest"
    },
    "dependencies": {
        "@elllphnt/elementa-base": "workspace:*",
        "@elllphnt/elementa-css": "workspace:*",
        "@elllphnt/elementa-kernel": "workspace:*",
        "@elllphnt/elementa-lang-utils": "workspace:*",
        "rxjs": "^7.8.2"
    },
    "devDependencies": {
        "@elllphnt/elementa-json-backend": "workspace:*"
    },
    "main": "build/index.js",
    "types": "build/index.d.ts"
}
