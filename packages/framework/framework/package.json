{
    "name": "@elllphnt/elementa-framework",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        "./start": {
            "types": "./build/start/index.d.ts",
            "import": "./build/start/index.js"
        },
        "./navigation": {
            "types": "./build/navigation.d.ts",
            "import": "./build/navigation.js"
        },
        "./jsx-runtime": {
            "types": "./build/jsx-runtime.d.ts",
            "import": "./build/jsx-runtime.js"
        }
    },
    "scripts": {
        "clean": "rm -rf build && rm -rf dist",
        "build": "npm run lint && tsc -p tsconfig.build.json",
        "watch": "tsc -w -p tsconfig.build.json",
        "pub": "npm run clean && npm run build && packup && cd dist && npm publish",
        "lint": "eslint src",
        "test": "vitest",
        "test:run": "vitest --run",
        "types": "tsc src/index.ts --declaration --emitDeclarationOnly --outFile schema/index.d.ts"
    },
    "dependencies": {
        "@tanstack/react-router": "^1.121.27",
        "@elllphnt/elementa-jsx": "workspace:*",
        "react": "^19.1.0"
    },
    "devDependencies": {
        "@repo/scripts": "workspace:*"
    }
}