{
    "name": "@elllphnt/elementa-models",
    "private": true,
    "version": "0.1.0",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "npm run lint && tsc -p tsconfig.build.json && tscpaths -p tsconfig.build.json -s ./src -o ./build",
        "watch": "tsc-watch --project tsconfig.build.json --onSuccess \"tscpaths -p tsconfig.build.json -s ./src -o ./build\" --onFailure \"tscpaths -p tsconfig.build.json -s ./src -o ./build\"",
        "test": "tsx tests/_.test.ts"
    },
    "dependencies": {
        "@elllphnt/elementa-base": "workspace:*",
        "@elllphnt/elementa-css": "workspace:*",
        "@elllphnt/elementa-utils": "workspace:*",
        "@paralleldrive/cuid2": "^2.2.2",
        "lodash": "^4.17.21",
        "rxjs": "^7.8.1",
        "yjs": "^13.6.26"
    }
}