{
  "name": "@elllphnt/elementa-standardizer",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "clean": "rm -rf build && rm -rf dist",
    "build": "npm run lint && tsc -p tsconfig.build.json",
    "watch": "tsc -w -p tsconfig.build.json",
    "packup": "tsx scripts/packup.ts",
    "pub": "npm run clean && npm run build && npm run packup && cd dist && npm publish",
    "lint": "eslint src",
    "test": "vitest",
    "test:run": "vitest --run",
    "types": "tsc src/index.ts --declaration --emitDeclarationOnly --outFile schema/index.d.ts"
  },
  "dependencies": {
    "@babel/generator": "^7.27.3",
    "@babel/parser": "^7.27.3",
    "@babel/traverse": "^7.27.3",
    "@babel/types": "^7.27.3",
    "@elllphnt/elementa-base": "workspace:*",
    "@elllphnt/elementa-transformer-primitives": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "postcss": "^8.5.4",
    "ts-morph": "^26.0.0"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.20.7",
    "deepmerge": "^4.3.1"
  }
}