    {
      "id": "djbdno4m",
      "name": "state_4",
      "varName": "state_4",
      "type": "inline",
      "script": "const appointment = state_1.getAppointmentById(props.appointmentId);\nconst patient = appointment ? state_2.getPatientById(appointment.patientId) : null;\nconst doctor = appointment ? state_3.getDoctorById(appointment.doctorId) : null;\nconst [statusUpdating, setStatusUpdating] = useState(false);\nconst handleStatusUpdate = async (\n  newStatus: \"confirmed\" | \"completed\" | \"cancelled\"\n) => {\n  if (!appointment) return;\n\n  setStatusUpdating(true);\n  try {\n    await state_1.updateAppointmentStatus(appointment.id, newStatus);\n  } catch (error) {\n    // Error handling is done in the hook\n  } finally {\n    setStatusUpdating(false);\n  }\n};\nif (!appointment) {\n  return (\n    fragments.fragment_1()\n  );\n}\nconst formatDateTime = (date: string, time: string) => {\n  const appointmentDate = new Date(`${date} ${time}`);\n  return appointmentDate.toLocaleString();\n};\nconst isUpcoming = () => {\n  const appointmentDate = new Date(`${appointment.date} ${appointment.time}`);\n  return appointmentDate > new Date();\n};\nconst canConfirm = appointment.status === \"scheduled\";\nconst canComplete =\n  appointment.status === \"scheduled\" || appointment.status === \"confirmed\";\nconst canCancel =\n  appointment.status !== \"cancelled\" && appointment.status !== \"completed\";\nreturn (\n  fragments.fragment_17({ appointment, formatDateTime, canConfirm, handleStatusUpdate, statusUpdating, canComplete, canCancel, patient, doctor })\n);"
    }
  ],
