    {
      "id": "xdnzgcjf",
      "name": "state_4",
      "varName": "state_4",
      "type": "inline",
      "script": "const [filter, setFilter] = useState<\n  \"all\" | \"upcoming\" | \"today\" | \"completed\"\n>(\"all\");\nconst getPatientName = (patientId: string) => {\n  const patient = state_2.patients.find((p) => p.id === patientId);\n  return patient\n    ? `${patient.firstName} ${patient.lastName}`\n    : \"Unknown Patient\";\n};\nconst getDoctorName = (doctorId: string) => {\n  const doctor = state_3.doctors.find((d) => d.id === doctorId);\n  return doctor ? `${doctor.firstName} ${doctor.lastName}` : \"Unknown Doctor\";\n};\nconst filterAppointments = () => {\n  const today = new Date();\n  today.setHours(0, 0, 0, 0);\n\n  switch (filter) {\n    case \"today\":\n      return state_1.appointments.filter((apt) => {\n        const aptDate = new Date(apt.date);\n        aptDate.setHours(0, 0, 0, 0);\n        return aptDate.getTime() === today.getTime();\n      });\n    case \"upcoming\":\n      return state_1.appointments.filter((apt) => {\n        const aptDate = new Date(apt.date);\n        return (\n          aptDate >= today &&\n          apt.status !== \"cancelled\" &&\n          apt.status !== \"completed\"\n        );\n      });\n    case \"completed\":\n      return state_1.appointments.filter((apt) => apt.status === \"completed\");\n    default:\n      return state_1.appointments;\n  }\n};\nconst filteredAppointments = filterAppointments().sort((a, b) => {\n  const dateA = new Date(`${a.date} ${a.time}`);\n  const dateB = new Date(`${b.date} ${b.time}`);\n  return dateB.getTime() - dateA.getTime();\n});\nconst handleStatusUpdate = async (\n  appointmentId: string,\n  newStatus: \"confirmed\" | \"completed\" | \"cancelled\"\n) => {\n  try {\n    await state_1.updateAppointmentStatus(appointmentId, newStatus);\n  } catch (error) {\n    // Error handling is done in the hook\n  }\n};\nif (state_1.loading) {\n  return (\n    fragments.fragment_1()\n  );\n}\nif (state_1.error) {\n  return (\n    fragments.fragment_2({ error: state_1.error })\n  );\n}\nreturn (\n  fragments.fragment_13({ setFilter, filter, filteredAppointments, getPatientName, getDoctorName, handleStatusUpdate })\n);"
    }
  ],
