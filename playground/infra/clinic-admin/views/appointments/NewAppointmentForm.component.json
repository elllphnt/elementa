      "script": "const [formData, setFormData] = useState<AppointmentFormData>({\n  patientId: \"\",\n  doctorId: \"\",\n  date: \"\",\n  time: \"\",\n  type: \"consultation\",\n  notes: \"\",\n  symptoms: [],\n});\nconst [symptomInput, setSymptomInput] = useState(\"\");\nconst [errors, setErrors] = useState<Partial<AppointmentFormData>>({});\nconst [submitError, setSubmitError] = useState<string | null>(null);\nconst [submitSuccess, setSubmitSuccess] = useState(false);\nuseEffect(() => {\n  const urlParams = new URLSearchParams(window.location.search);\n  const patientId = urlParams.get(\"patientId\");\n  if (patientId) {\n    setFormData((prev) => ({ ...prev, patientId }));\n  }\n}, []);\nconst validateForm = (): boolean => {\n  const newErrors: Partial<AppointmentFormData> = {};\n\n  if (!formData.patientId) newErrors.patientId = \"Patient is required\";\n  if (!formData.doctorId) newErrors.doctorId = \"Doctor is required\";\n  if (!formData.date) newErrors.date = \"Date is required\";\n  if (!formData.time) newErrors.time = \"Time is required\";\n  if (!formData.type) newErrors.type = \"Appointment type is required\";\n\n  // Validate date is not in the past\n  if (formData.date) {\n    const selectedDate = new Date(formData.date);\n    const today = new Date();\n    today.setHours(0, 0, 0, 0);\n    if (selectedDate < today) {\n      newErrors.date = \"Appointment date cannot be in the past\";\n    }\n  }\n\n  setErrors(newErrors);\n  return Object.keys(newErrors).length === 0;\n};\nconst handleSubmit = async (e: React.FormEvent) => {\n  e.preventDefault();\n\n  if (!validateForm()) return;\n\n  try {\n    setSubmitError(null);\n    await state_1.createAppointment(formData);\n    setSubmitSuccess(true);\n    // Reset form\n    setFormData({\n      patientId: \"\",\n      doctorId: \"\",\n      date: \"\",\n      time: \"\",\n      type: \"consultation\",\n      notes: \"\",\n      symptoms: [],\n    });\n    setSymptomInput(\"\");\n  } catch (error) {\n    setSubmitError(\"Failed to create appointment. Please try again.\");\n  }\n};\nconst handleInputChange = (\n  field: keyof AppointmentFormData,\n  value: string | string[]\n) => {\n  setFormData((prev) => ({\n    ...prev,\n    [field]: value,\n  }));\n  // Clear error when user starts typing\n  if (errors[field]) {\n    setErrors((prev) => ({\n      ...prev,\n      [field]: undefined,\n    }));\n  }\n};\nconst addSymptom = () => {\n  if (\n    symptomInput.trim() &&\n    !formData.symptoms.includes(symptomInput.trim())\n  ) {\n    setFormData((prev) => ({\n      ...prev,\n      symptoms: [...prev.symptoms, symptomInput.trim()],\n    }));\n    setSymptomInput(\"\");\n  }\n};\nconst removeSymptom = (symptom: string) => {\n  setFormData((prev) => ({\n    ...prev,\n    symptoms: prev.symptoms.filter((s) => s !== symptom),\n  }));\n};\nconst handleSymptomKeyPress = (e: React.KeyboardEvent) => {\n  if (e.key === \"Enter\") {\n    e.preventDefault();\n    addSymptom();\n  }\n};\nconst today = new Date().toISOString().split(\"T\")[0];\nif (submitSuccess) {\n  return (\n    fragments.fragment_1({ setSubmitSuccess })\n  );\n}\nreturn (\n  fragments.fragment_12({ handleSubmit, submitError, formData, handleInputChange, errors, patients: state_2.patients, doctors: state_3.doctors, today, symptomInput, setSymptomInput, handleSymptomKeyPress, addSymptom, removeSymptom, loading: state_1.loading })\n);"
