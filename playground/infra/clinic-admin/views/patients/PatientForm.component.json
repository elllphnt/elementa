    {
      "id": "styobsvv",
      "name": "state_2",
      "varName": "state_2",
      "type": "inline",
      "script": "const [formData, setFormData] = useState<PatientFormData>({\n  firstName: \"\",\n  lastName: \"\",\n  email: \"\",\n  phone: \"\",\n  dateOfBirth: \"\",\n  address: \"\",\n  emergencyContact: {\n    name: \"\",\n    phone: \"\",\n    relationship: \"\",\n  },\n});\nconst [errors, setErrors] = useState<Partial<PatientFormData>>({});\nconst [submitError, setSubmitError] = useState<string | null>(null);\nconst [submitSuccess, setSubmitSuccess] = useState(false);\nconst validateForm = (): boolean => {\n  const newErrors: Partial<PatientFormData> = {};\n\n  if (!formData.firstName.trim())\n    newErrors.firstName = \"First name is required\";\n  if (!formData.lastName.trim()) newErrors.lastName = \"Last name is required\";\n  if (!formData.email.trim()) newErrors.email = \"Email is required\";\n  else if (!/\\S+@\\S+\\.\\S+/.test(formData.email))\n    newErrors.email = \"Email is invalid\";\n  if (!formData.phone.trim()) newErrors.phone = \"Phone number is required\";\n  if (!formData.dateOfBirth)\n    newErrors.dateOfBirth = \"Date of birth is required\";\n  if (!formData.address.trim()) newErrors.address = \"Address is required\";\n\n  setErrors(newErrors);\n  return Object.keys(newErrors).length === 0;\n};\nconst handleSubmit = async (e: React.FormEvent) => {\n  e.preventDefault();\n\n  if (!validateForm()) return;\n\n  try {\n    setSubmitError(null);\n    await state_1.createPatient(formData);\n    setSubmitSuccess(true);\n    // Reset form\n    setFormData({\n      firstName: \"\",\n      lastName: \"\",\n      email: \"\",\n      phone: \"\",\n      dateOfBirth: \"\",\n      address: \"\",\n      emergencyContact: {\n        name: \"\",\n        phone: \"\",\n        relationship: \"\",\n      },\n    });\n  } catch (error) {\n    setSubmitError(\"Failed to create patient. Please try again.\");\n  }\n};\nconst handleInputChange = (field: keyof PatientFormData, value: string) => {\n  setFormData((prev) => ({\n    ...prev,\n    [field]: value,\n  }));\n  // Clear error when user starts typing\n  if (errors[field]) {\n    setErrors((prev) => ({\n      ...prev,\n      [field]: undefined,\n    }));\n  }\n};\nconst handleEmergencyContactChange = (\n  field: keyof PatientFormData[\"emergencyContact\"],\n  value: string\n) => {\n  setFormData((prev) => ({\n    ...prev,\n    emergencyContact: {\n      ...prev.emergencyContact,\n      [field]: value,\n    },\n  }));\n};\nif (submitSuccess) {\n  return (\n    fragments.fragment_1({ setSubmitSuccess })\n  );\n}\nreturn (\n  fragments.fragment_9({ handleSubmit, submitError, formData, handleInputChange, errors, handleEmergencyContactChange, loading: state_1.loading })\n);"
    }
  ],
