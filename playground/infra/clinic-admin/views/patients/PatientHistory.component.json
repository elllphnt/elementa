      "name": "state_4",
      "varName": "state_4",
      "type": "inline",
      "script": "const patient = state_1.getPatientById(props.patientId);\nconst appointments = state_2.getAppointmentsByPatientId(props.patientId);\nconst sortedAppointments = appointments.sort((a, b) => {\n  const dateA = new Date(`${a.date} ${a.time}`);\n  const dateB = new Date(`${b.date} ${b.time}`);\n  return dateB.getTime() - dateA.getTime();\n});\nconst completedAppointments = sortedAppointments.filter(\n  (apt) => apt.status === \"completed\"\n);\nconst upcomingAppointments = sortedAppointments.filter((apt) => {\n  const aptDate = new Date(apt.date);\n  const today = new Date();\n  return aptDate >= today && apt.status !== \"cancelled\";\n});\nif (!patient) {\n  return (\n    fragments.fragment_1()\n  );\n}\nconst getDoctorName = (doctorId: string) => {\n  const doctor = state_3.getDoctorById(doctorId);\n  return doctor ? `${doctor.firstName} ${doctor.lastName}` : \"Unknown Doctor\";\n};\nreturn (\n  fragments.fragment_17({ patient, upcomingAppointments, getDoctorName, completedAppointments, appointments })\n);"
    }
  ],
