      "varName": "state_3",
      "type": "inline",
      "script": "const patient = state_1.getPatientById(props.patientId);\nconst appointments = state_2.getAppointmentsByPatientId(props.patientId);\nconst upcomingAppointments = appointments\n  .filter((apt) => {\n    const aptDate = new Date(apt.date);\n    const today = new Date();\n    return aptDate >= today && apt.status !== \"cancelled\";\n  })\n  .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime());\nconst pastAppointments = appointments\n  .filter((apt) => {\n    const aptDate = new Date(apt.date);\n    const today = new Date();\n    return aptDate < today || apt.status === \"completed\";\n  })\n  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());\nif (state_1.patientLoading || state_2.appointmentsLoading) {\n  return (\n    fragments.fragment_1()\n  );\n}\nif (!patient) {\n  return (\n    fragments.fragment_2()\n  );\n}\nreturn (\n  fragments.fragment_11({ patient, upcomingAppointments, pastAppointments })\n);"
