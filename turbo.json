{
    "globalEnv": [
        "GITHUB_TOKEN"
    ],
    "$schema": "https://turborepo.org/schema.json",
    "tasks": {
        "build": {
            "outputs": [
                "dist/**",
                "build/**"
            ],
            "dependsOn": [
                "^build"
            ]
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "cache": false,
            "persistent": true
        }
    }
}